# Copy to .env and fill in. Docker Compose reads it automatically.

# Needed for Claude features: task suggestions, finding manuals, reading documents.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Recommended whenever anyone else can reach the app (home server, VPS).
# Leave empty to turn sign-in off.
HOUSEKEEPING_PASSWORD=
HOUSEKEEPING_USERNAME=admin

# Port on the host. The container always listens on 8000.
PORT=8000

# Claude model to use.
# HOUSEKEEPING_MODEL=claude-opus-5-5

# Image tag to run with Compose: latest, or a version like 0.2.0 to stay on it.
# HOUSEKEEPING_VERSION=latest
